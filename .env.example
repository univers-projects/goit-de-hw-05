# Kafka broker, for example localhost:9092 or host1:9092,host2:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# This suffix makes topic names unique for this homework.
TOPIC_SUFFIX=univers

# Optional Kafka security settings. Leave empty for a local broker.
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=...
# KAFKA_SASL_PASSWORD=...
